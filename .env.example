OPENAI_API_KEY=
MODEL=gpt-5

YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# Set before exposing the API beyond localhost.
API_KEY=

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: OpenWeatherMap. Weather stays "not configured" without these.
WEATHER_API_KEY=
WEATHER_LOCATION=

# Optional: Google Calendar sync (not usable without a registered OAuth app).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

EMBEDDING_MODEL=text-embedding-3-small
