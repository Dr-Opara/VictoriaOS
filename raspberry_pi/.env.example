MINI_PC_URL=http://192.168.1.100:8000
API_KEY=

INPUT_DEVICE_HINT=respeaker,seeed,usb
OUTPUT_DEVICE_HINT=

SAMPLE_RATE=16000
CHANNELS=1
FRAME_MS=30

VAD_ENERGY_THRESHOLD=500
SILENCE_TIMEOUT_MS=800
MAX_UTTERANCE_SECONDS=20

WAKE_WORD_PHRASE=hello victoria
# Path to a trained openWakeWord .onnx model. Leave blank to run in VAD
# fallback mode (see raspberry_pi/wakeword/null_engine.py).
WAKE_WORD_MODEL_PATH=
WAKE_WORD_THRESHOLD=0.5

CONVERSATION_TIMEOUT_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=10
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=30

SPEAKER_VERIFICATION_ENABLED=false

VOICE_NODE_LOG_DIR=logs
